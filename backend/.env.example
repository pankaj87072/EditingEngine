# ─────────────────────────────────────────────────────────────────────────────
# AutoVideoGen — Environment Variables
# Copy this file to .env and fill in your values.
# cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
APP_NAME=AutoVideoGen
APP_VERSION=1.0.0
DEBUG=false

# ── Redis / Celery ────────────────────────────────────────────────────────────
# Local Redis (default):
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ── TTS Provider ─────────────────────────────────────────────────────────────
# Options: "google" | "elevenlabs"
TTS_PROVIDER=google

# Google TTS (Cloud SDK — requires GOOGLE_APPLICATION_CREDENTIALS)
# If google-cloud-texttospeech is not installed, falls back to gTTS (free).
GOOGLE_TTS_LANGUAGE=en-US
GOOGLE_TTS_VOICE=en-US-Neural2-D
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# ElevenLabs (requires API key)
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# ── Video Output ──────────────────────────────────────────────────────────────
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
VIDEO_FPS=30
VIDEO_BITRATE=4M
AUDIO_BITRATE=192k

# Transition type: "fade" | "crossfade" | "zoom"
DEFAULT_TRANSITION=fade
TRANSITION_DURATION=0.5

# Ken Burns zoom level (1.0 = none, 1.15 = 15% zoom)
ZOOM_INTENSITY=1.10

# ── Subtitle Styling ──────────────────────────────────────────────────────────
SUBTITLE_FONT=Arial
SUBTITLE_FONT_SIZE=60
SUBTITLE_COLOR=white
SUBTITLE_OUTLINE_COLOR=black
SUBTITLE_OUTLINE_WIDTH=3

# ── Script Segmentation ───────────────────────────────────────────────────────
WORDS_PER_SECOND=2.5
MIN_SCENE_DURATION=3.0
MAX_SCENE_DURATION=15.0

# ── Editing planner (optional) ───────────────────────────────────────────────
# One small structured LLM call per Reel picks clips, start offsets, zoom, crop
# and caption emphasis. Leave the key empty to use the built-in rules instead.
ANTHROPIC_API_KEY=
PLANNER_ENABLED=true
PLANNER_MODEL=claude-haiku-4-5-20251001
PLANNER_TIMEOUT=25

# ── Accounts (optional) ──────────────────────────────────────────────────────
# false = single-user mode, no login (default). true = register/login required and
# every Reel belongs to its owner. AUTH_SECRET empty = generated once in data/.auth_secret
AUTH_ENABLED=false
AUTH_SECRET=
AUTH_TOKEN_TTL_HOURS=168

# ── Voice ────────────────────────────────────────────────────────────────────
# TTS_PROVIDER=auto  -> ElevenLabs when ELEVENLABS_API_KEY is set, otherwise Google. Google is always the fallback.
TTS_PROVIDER=auto
ELEVENLABS_API_KEY=
# Pick a voice with an Indian accent for Hinglish. Find IDs in your ElevenLabs voice library.
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
# eleven_multilingual_v2 = emotion via voice settings (default). eleven_v3 = emotion via inline audio tags (not verified here).
ELEVENLABS_MODEL=eleven_multilingual_v2
TTS_MAX_CONCURRENCY=3
TTS_CACHE=true
GOOGLE_TTS_LANGUAGE=en-IN
GOOGLE_TTS_VOICE=en-IN-Neural2-B

# ── Rendering / performance ──────────────────────────────────────────────────
SINGLE_PASS_COMPOSITION=true     # one filter graph + one encode; falls back to the multi-stage path on error
MOTION_ENGINE=zoompan            # or "scale" (~5% faster)
VIDEO_PRESET=veryfast
VIDEO_CRF=20
VIDEO_MAXRATE=12M
AUDIO_NORMALIZE=true
BACKGROUND_MUSIC_PATH=           # optional: a music file, ducked automatically under the narration
MUSIC_VOLUME=0.18
ANALYZER_WORKERS=3
QUALITY_DECODE=edges             # edges | full | off
